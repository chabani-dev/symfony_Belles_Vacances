{% extends 'base.html.twig' %}

{% block title %}Resevation{% endblock %}

{% block body %}
    <h1>Resevation</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ resevation.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ resevation.title }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ resevation.description }}</td>
            </tr>
            <tr>
                <th>Amount</th>
                <td>{{ resevation.amount }}</td>
            </tr>
            <tr>
                <th>Comment</th>
                <td>{{ resevation.comment }}</td>
            </tr>
            <tr>
                <th>Picture</th>
                <td>{{ resevation.picture }}</td>
            </tr>
            <tr>
                <th>ReservationNumber</th>
                <td>{{ resevation.reservationNumber }}</td>
            </tr>
            <tr>
                <th>DateRervation</th>
                <td>{{ resevation.dateRervation ? resevation.dateRervation|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_resevation_index') }}">back to list</a>

    <a href="{{ path('app_resevation_edit', {'id': resevation.id}) }}">edit</a>

    {{ include('resevation/_delete_form.html.twig') }}
{% endblock %}
