{% extends 'base.html.twig' %}

{% block title %}Resevation index{% endblock %}

{% block body %}
    <h1>Resevation index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Description</th>
                <th>Amount</th>
                <th>Comment</th>
                <th>Picture</th>
                <th>ReservationNumber</th>
                <th>DateRervation</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for resevation in resevations %}
            <tr>
                <td>{{ resevation.id }}</td>
                <td>{{ resevation.title }}</td>
                <td>{{ resevation.description }}</td>
                <td>{{ resevation.amount }}</td>
                <td>{{ resevation.comment }}</td>
                <td>{{ resevation.picture }}</td>
                <td>{{ resevation.reservationNumber }}</td>
                <td>{{ resevation.dateRervation ? resevation.dateRervation|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_resevation_show', {'id': resevation.id}) }}">show</a>
                    <a href="{{ path('app_resevation_edit', {'id': resevation.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_resevation_new') }}">Create new</a>
{% endblock %}
